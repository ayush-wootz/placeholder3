# LLM Provider
OPENAI_API_KEY=your-openai-api-key

# Proprietary Data - Vector DB (Option A)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=your-index-name
PINECONE_ENVIRONMENT=your-environment

# Proprietary Data - Structured DB (Option B)
POSTGRES_URL=postgresql://user:password@localhost:5432/dbname

# Proprietary Data - Document Store (Option C)
ELASTICSEARCH_URL=http://localhost:9200

# Web Search
SERPER_API_KEY=your-serper-api-key

# Bot Config
BOT_NAME=ResearchBot
INTERNAL_KEYWORDS=project,status,team,our,internal,sprint,deploy,release
WEB_RATE_LIMIT=5
MAX_MESSAGE_LENGTH=600
