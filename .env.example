# LLM Provider (for answer synthesis)
OPENAI_API_KEY=your-openai-api-key

# ZAI Database (Render Postgres + pgvector)
POSTGRES_URL=postgresql://zai_wootz:PASSWORD@dpg-XXXXX.render.com:5432/zai_u2sh
TENANT_ID=your-tenant-id

# Embedding config (must match what ZAI used to ingest your data)
# Options: "openai_compat" or "gemini"
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your-gemini-or-openai-api-key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=1536

# Web Search (optional — fallback when no internal data matches)
SERPER_API_KEY=your-serper-api-key

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_VERIFY_TOKEN=any-secret-string-you-choose

# Bot Config
BOT_NAME=ZAI
INTERNAL_KEYWORDS=project,status,team,our,internal,sprint,deploy,release,checkin,incident,ccp,dashboard
WEB_RATE_LIMIT=5
MAX_MESSAGE_LENGTH=600
